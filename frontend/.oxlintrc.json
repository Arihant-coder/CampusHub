{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/features/communities/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/features/daily-quiz/**",
                  "@/features/dashboard/**",
                  "@/features/subjects/**",
                  "../daily-quiz/**",
                  "../dashboard/**",
                  "../subjects/**"
                ],
                "message": "Files in features/communities may not import from other features. Files in features/* may import only from components/ui, lib/, shared/ and their own folder."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/daily-quiz/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/features/communities/**",
                  "@/features/dashboard/**",
                  "@/features/subjects/**",
                  "../communities/**",
                  "../dashboard/**",
                  "../subjects/**"
                ],
                "message": "Files in features/daily-quiz may not import from other features. Files in features/* may import only from components/ui, lib/, shared/ and their own folder."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/dashboard/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/features/communities/**",
                  "@/features/daily-quiz/**",
                  "@/features/subjects/**",
                  "../communities/**",
                  "../daily-quiz/**",
                  "../subjects/**"
                ],
                "message": "Files in features/dashboard may not import from other features. Files in features/* may import only from components/ui, lib/, shared/ and their own folder."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/subjects/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/features/communities/**",
                  "@/features/daily-quiz/**",
                  "@/features/dashboard/**",
                  "../communities/**",
                  "../daily-quiz/**",
                  "../dashboard/**"
                ],
                "message": "Files in features/subjects may not import from other features. Files in features/* may import only from components/ui, lib/, shared/ and their own folder."
              }
            ]
          }
        ]
      }
    }
  ]
}
