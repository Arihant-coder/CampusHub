# ==============================================================================
# CampusHub Frontend Environment Template (.env.example)
#
# QUICK START:
# 1. Copy this template to create your personal local overrides file:
#    - Windows (PowerShell): Copy-Item .env.example .env.local
#    - macOS / Linux:        cp .env.example .env.local
# 2. Adjust the variables below according to your development profile.
# 3. .env.local is ignored by Git and should NEVER be committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Client Configuration
# Required when VITE_USE_MOCKS=false. Obtain these from your Supabase Dashboard.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ------------------------------------------------------------------------------
# 2. FastAPI Backend Service URL
# ------------------------------------------------------------------------------
VITE_BACKEND_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 3. Mock Services Switch
# - Set to 'true' to develop UI offline with realistic mock data and simulated latency.
# - Set to 'false' to connect to live Supabase and FastAPI backend services.
# ------------------------------------------------------------------------------
VITE_USE_MOCKS=true

# ------------------------------------------------------------------------------
# 4. Mock Role Bypass (Mock Mode Only)
# - Set to 'student', 'moderator', or 'admin' to bypass the /login screen and
#   automatically authenticate into that role upon page load.
# - Leave blank to display the interactive login screen with one-click presets.
# ------------------------------------------------------------------------------
VITE_MOCK_ROLE=

